# PulmoSense dashboard — environment configuration
#
# Copy this file to `.env.local` (git-ignored) and adjust as needed.

# --- Real backend (recommended) -------------------------------------------
# Base URL of the FastAPI analysis backend. When set, the dashboard calls
# POST {VITE_API_BASE}/analyze and GET {VITE_API_BASE}/health for real
# MATLAB inference. Leave empty to disable real mode.
VITE_API_BASE=http://127.0.0.1:8000

# --- Demo mode (opt-in, clearly labelled) ---------------------------------
# Set to "true" ONLY to run the dashboard on simulated analysis data with no
# backend. Demo results are always labelled "Demo data". Ignored when
# VITE_API_BASE is set.
VITE_DEMO_MODE=false
