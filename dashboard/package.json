{
  "name": "pulmosense-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Smart Respiratory Lung Analysis System — a research prototype for DSP + machine-learning analysis of respiratory acoustic patterns (web dashboard frontend)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate-sample": "node scripts/generateSample.mjs",
    "check-pipeline": "esbuild scripts/pipelineCheck.ts --bundle --platform=node --format=esm --outfile=.pipeline-check.mjs && node .pipeline-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
